<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="500.0" spacing="0.0" style="-fx-background-color: #EBF3F9;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.naptien.NapTienController">
    <children>

        <VBox alignment="CENTER" spacing="10.0">
            <children>
                <Label text="NẠP TIỀN TÀI KHOẢN" textFill="#2A628F">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>
                <Label text="Hỗ trợ quy đổi nhanh qua đơn vị K và M" textFill="#6C8EAD">
                    <font>
                        <Font name="System Italic" size="14.0" />
                    </font>
                </Label>
            </children>
            <VBox.margin>
                <Insets bottom="35.0" />
            </VBox.margin>
        </VBox>

        <VBox alignment="CENTER" maxWidth="420.0" spacing="25.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 18; -fx-effect: dropshadow(three-pass-box, rgba(42, 98, 143, 0.15), 15, 0, 0, 8);">
            <padding>
                <Insets bottom="35.0" left="25.0" right="25.0" top="35.0" />
            </padding>
            <children>

                <VBox spacing="8.0" maxWidth="370.0">
                    <children>
                        <Label text="Số tiền cần nạp" textFill="#4A6984">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>

                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <TextField fx:id="txtSoTien" prefHeight="48.0" prefWidth="260.0" promptText="Ví dụ: 500K, 2M hoặc 100000" style="-fx-background-color: #F0F4F8; -fx-background-radius: 10; -fx-border-color: #D3E0EA; -fx-border-radius: 10; -fx-border-width: 1.5;">
                                    <font>
                                        <Font size="15.0" />
                                    </font>
                                    <padding>
                                        <Insets left="15.0" right="15.0" />
                                    </padding>
                                </TextField>
                                <Button mnemonicParsing="false" onAction="#handleButtonNap" prefHeight="48.0" prefWidth="100.0" style="-fx-background-color: linear-gradient(to right, #3A7BD5, #3A6073); -fx-background-radius: 10; -fx-text-fill: white; -fx-cursor: hand;" text="Nạp Ngay">
                                    <font>
                                        <Font name="System Bold" size="15.0" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox maxWidth="370.0" prefHeight="1.0" style="-fx-background-color: #E6EEF4;" />

                <VBox spacing="10.0" maxWidth="370.0">
                    <children>
                        <Label text="Chọn nhanh mức nạp" textFill="#7A93A6">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>

                        <HBox alignment="CENTER" spacing="8.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#bt1" prefHeight="38.0" prefWidth="86.0" style="-fx-background-color: #EBF3F9; -fx-text-fill: #2A628F; -fx-background-radius: 8; -fx-border-color: #B9D2E6; -fx-border-radius: 8; -fx-cursor: hand;" text="100K">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Button>
                                <Button mnemonicParsing="false" onAction="#bt2" prefHeight="38.0" prefWidth="86.0" style="-fx-background-color: #EBF3F9; -fx-text-fill: #2A628F; -fx-background-radius: 8; -fx-border-color: #B9D2E6; -fx-border-radius: 8; -fx-cursor: hand;" text="1M">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Button>
                                <Button mnemonicParsing="false" onAction="#bt3" prefHeight="38.0" prefWidth="86.0" style="-fx-background-color: #EBF3F9; -fx-text-fill: #2A628F; -fx-background-radius: 8; -fx-border-color: #B9D2E6; -fx-border-radius: 8; -fx-cursor: hand;" text="10M">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Button>
                                <Button mnemonicParsing="false" onAction="#bt4" prefHeight="38.0" prefWidth="86.0" style="-fx-background-color: #EBF3F9; -fx-text-fill: #2A628F; -fx-background-radius: 8; -fx-border-color: #B9D2E6; -fx-border-radius: 8; -fx-cursor: hand;" text="100M">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>

            </children>
        </VBox>

    </children>
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
</VBox>
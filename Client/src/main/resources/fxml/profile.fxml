<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="View.ProfileController">

    <!-- ================= HEADER ================= -->
    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="20" right="20" bottom="15" left="20"/>
            </padding>

            <Label text="My Profile"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;" />

            <GridPane hgap="10" vgap="5">

                <Label text="Fullname:"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <Label fx:id="fullnameLabel"
                       text="fullname"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="1"/>

                <Label text="Username:"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>

                <Label fx:id="usernameLabel"
                       text="username"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="1"/>

                <Label text="Email:"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>

                <Label fx:id="emailLabel"
                       text="email@example.com"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="1"/>

                <Label text="Member Since:"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="0"/>

                <Label fx:id="memberSinceLabel"
                       text="2026-01-01"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="1"/>

            </GridPane>

        </VBox>
    </top>

    <!-- ================= CENTER ================= -->
    <center>
        <VBox spacing="15">

            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>

            <!-- STATISTICS -->
            <HBox spacing="15">

                <VBox spacing="5"
                      style="-fx-border-color: lightgray;
                             -fx-border-radius: 8;
                             -fx-padding: 15;"
                      HBox.hgrow="ALWAYS">

                    <Label text="Participated"/>
                    <Label fx:id="participatedLabel"
                           text="0"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;"/>

                </VBox>

                <VBox spacing="5"
                      style="-fx-border-color: lightgray;
                             -fx-border-radius: 8;
                             -fx-padding: 15;"
                      HBox.hgrow="ALWAYS">

                    <Label text="Won Auctions"/>
                    <Label fx:id="wonLabel"
                           text="0"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;"/>

                </VBox>

                <VBox spacing="5"
                      style="-fx-border-color: lightgray;
                             -fx-border-radius: 8;
                             -fx-padding: 15;"
                      HBox.hgrow="ALWAYS">

                    <Label text="Products Listed"/>
                    <Label fx:id="productsLabel"
                           text="0"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;"/>

                </VBox>

                <VBox spacing="5"
                      style="-fx-border-color: lightgray;
                             -fx-border-radius: 8;
                             -fx-padding: 15;"
                      HBox.hgrow="ALWAYS">

                    <Label text="Revenue"/>
                    <Label fx:id="revenueLabel"
                           text="0 VNĐ"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;"/>

                </VBox>

            </HBox>

            <!-- FILTER BUTTONS -->
            <HBox spacing="10">

                <Button text="My Auctions"
                        fx:id="myAuctionsBtn"
                        onAction="#showMyAuctions"/>

                <Button text="Bid History"
                        fx:id="bidHistoryBtn"
                        onAction="#showBidHistory"/>

                <Button text="Won Auctions"
                        fx:id="wonAuctionsBtn"
                        onAction="#showWonAuctions"/>

                <Button text="My Products"
                        fx:id="myProductsBtn"
                        onAction="#showMyProducts"/>

            </HBox>

            <!-- SECTION TITLE -->
            <Label fx:id="sectionTitle"
                   text="My Auctions"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;"/>

            <!-- SINGLE TABLE -->
            <TableView fx:id="dataTable"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="col1"
                                 text="Column 1"/>

                    <TableColumn fx:id="col2"
                                 text="Column 2"/>

                    <TableColumn fx:id="col3"
                                 text="Column 3"/>

                    <TableColumn fx:id="col4"
                                 text="Column 4"/>

                </columns>

            </TableView>

        </VBox>
    </center>

</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="View.AuctionListController">

    <VBox alignment="TOP_RIGHT" prefHeight="607.0" prefWidth="683.0" spacing="20.0">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>
        <children>
            <TextField alignment="TOP_CENTER" editable="false" prefHeight="47.0" prefWidth="643.0" text="Đấu Giá Sản Phẩm">
                <font>
                    <Font size="28.0" />
                </font>
            </TextField>
            <HBox alignment="TOP_RIGHT" maxWidth="250.0" prefHeight="43.0" prefWidth="175.0">
                <padding>
                    <Insets right="20.0" top="10.0" />
                </padding>
                <children>
                    <MenuButton fx:id="HelloName" mnemonicParsing="false" text="Hello, Guest">
                        <items>
                            <MenuItem mnemonicParsing="false" text="thông tin tài khoản" />
                            <MenuItem mnemonicParsing="false" onAction="#MainSceneSwitch" text="đăng xuất" />
                        </items>
                    </MenuButton>
                </children>
            </HBox>
            <HBox maxWidth="700.0" prefHeight="36.0" prefWidth="330.0" spacing="15.0">
                <children>
                    <Button mnemonicParsing="false" onAction="#ProductPublishingSwitch" text="Đăng Sản Phẩm" />
                    <Button alignment="TOP_LEFT" mnemonicParsing="false" text="Sản Phẩm Đấu Giá" />
                    <Button fx:id="btnTongQuanChart" mnemonicParsing="false" prefHeight="25.0" prefWidth="155.0" text="Xem Line Chart sản phẩm" />
                    <Button mnemonicParsing="false" prefHeight="25.0" prefWidth="86.0" text="Nạp Tiền" />
                </children>
            </HBox>
            <TableView fx:id="tableSanPhams" prefHeight="309.0" prefWidth="618.0">
                <columns>
                    <TableColumn fx:id="colTen" prefWidth="91.0" text="Loại sản phẩm" />
                    <TableColumn fx:id="colTenSanPham" prefWidth="121.0" text="Tên sản phẩm" />
                    <TableColumn fx:id="colGiaHienTai" prefWidth="95.5" text="Giá hiện tại" />
                    <TableColumn fx:id="colGiaMuaDut" minWidth="0.0" prefWidth="91.5" text="Giá mua luôn" />
                    <TableColumn fx:id="colThoiDiemKetThuc" maxWidth="220.0" prefWidth="129.0" text="Thời Điểm Khép Lại" />
                    <TableColumn fx:id="Status" prefWidth="114.0" text="Giai đoạn hiện tại" />
                </columns>
            </TableView>
            <HBox alignment="BOTTOM_CENTER" maxWidth="1.7976931348623157E308" prefHeight="53.0" prefWidth="643.0">
                <children>
                    <TextField maxWidth="1.7976931348623157E308" promptText="Nhập giá (giá phải cao hơn giá hiện tại)....">
                        <font>
                            <Font size="17.0" />
                        </font>
                    </TextField>
                    <Button mnemonicParsing="false" text="gửi giá">
                        <font>
                            <Font size="17.0" />
                        </font>
                    </Button>
                </children>
            </HBox>
        </children>
    </VBox>
</AnchorPane>

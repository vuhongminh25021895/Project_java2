<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="680.0" spacing="0.0" style="-fx-background-color: #EBF3F9;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="View.NapTienController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <VBox alignment="CENTER" spacing="10.0">
            <children>
                <Label text="NẠP TIỀN TÀI KHOẢN" textFill="#2A628F">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>
                <Label fx:id="lblCurrentUser" textFill="#6C8EAD">
                    <font>
                        <Font name="System Italic" size="14.0" />
                    </font>
                </Label>
            </children>
            <VBox.margin>
                <Insets bottom="35.0" />
            </VBox.margin>
        </VBox>

        <VBox alignment="CENTER" maxWidth="450.0" spacing="25.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 18; -fx-effect: dropshadow(three-pass-box, rgba(42, 98, 143, 0.15), 15, 0, 0, 8);">
            <padding>
                <Insets bottom="35.0" left="25.0" right="25.0" top="35.0" />
            </padding>
            <children>
                <VBox maxWidth="390.0" spacing="8.0">
                    <children>
                        <Label text="Số tiền muốn nạp" textFill="#4A6984">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <TextField fx:id="txtSoTien" prefHeight="48.0" prefWidth="270.0" promptText="Nhập số tiền của bạn" style="-fx-background-color: #F0F4F8; -fx-background-radius: 10; -fx-border-color: #D3E0EA; -fx-border-radius: 10; -fx-border-width: 1.5;">
                                    <font>
                                        <Font size="15.0" />
                                    </font>
                                    <padding>
                                        <Insets left="15.0" right="15.0" />
                                    </padding>
                                </TextField>
                                <Button mnemonicParsing="false" onAction="#handleButtonNap" prefHeight="48.0" prefWidth="100.0" style="-fx-background-color: linear-gradient(to right, #3A7BD5, #3A6073); -fx-background-radius: 10; -fx-text-fill: white; -fx-cursor: hand;" text="Nạp Ngay">
                                    <font>
                                        <Font name="System Bold" size="15.0" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <Label text="Bạn có thể nhập số thường hoặc số kèm K, M, B như 100K, 2M, 1B." wrapText="true" />

                <VBox maxWidth="390.0" prefHeight="1.0" style="-fx-background-color: #E6EEF4;" />

                <VBox maxWidth="390.0" spacing="10.0">
                    <children>
                        <Label text="Chọn nhanh mức nạp" textFill="#7A93A6">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                        <HBox alignment="CENTER" spacing="8.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#bt100K" prefHeight="38.0" prefWidth="70.0" style="-fx-background-color: #EBF3F9; -fx-text-fill: #2A628F; -fx-background-radius: 8; -fx-border-color: #B9D2E6; -fx-border-radius: 8; -fx-cursor: hand;" text="100K" />
                                <Button mnemonicParsing="false" onAction="#bt1M" prefHeight="38.0" prefWidth="70.0" style="-fx-background-color: #EBF3F9; -fx-text-fill: #2A628F; -fx-background-radius: 8; -fx-border-color: #B9D2E6; -fx-border-radius: 8; -fx-cursor: hand;" text="1M" />
                                <Button mnemonicParsing="false" onAction="#bt10M" prefHeight="38.0" prefWidth="70.0" style="-fx-background-color: #EBF3F9; -fx-text-fill: #2A628F; -fx-background-radius: 8; -fx-border-color: #B9D2E6; -fx-border-radius: 8; -fx-cursor: hand;" text="10M" />
                                <Button mnemonicParsing="false" onAction="#bt100M" prefHeight="38.0" prefWidth="70.0" style="-fx-background-color: #EBF3F9; -fx-text-fill: #2A628F; -fx-background-radius: 8; -fx-border-color: #B9D2E6; -fx-border-radius: 8; -fx-cursor: hand;" text="100M" />
                                <Button mnemonicParsing="false" onAction="#bt1B" prefHeight="38.0" prefWidth="70.0" style="-fx-background-color: #EBF3F9; -fx-text-fill: #2A628F; -fx-background-radius: 8; -fx-border-color: #B9D2E6; -fx-border-radius: 8; -fx-cursor: hand;" text="1B" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <Label fx:id="lblStatus" textFill="#2A628F" wrapText="true" />

                <Button mnemonicParsing="false" onAction="#backToAuctionList" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #E8EEF4; -fx-background-radius: 10; -fx-text-fill: #2A628F; -fx-cursor: hand;" text="Quay lại danh sách" />
            </children>
        </VBox>
    </children>
</VBox>

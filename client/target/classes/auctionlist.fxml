<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="View.AuctionListController">

    <!-- HEADER -->
    <top>
        <VBox spacing="15">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Title + Profile -->
            <HBox alignment="CENTER_LEFT">

                <Label text="ĐẤU GIÁ SẢN PHẨM">
                    <font>
                        <Font size="28"/>
                    </font>
                </Label>

                <Region HBox.hgrow="ALWAYS"/>

                <MenuButton fx:id="helloName"
                            text="Hello, Guest">

                    <items>
                        <MenuItem text="Thông tin tài khoản"/>
                        <MenuItem text="Đăng xuất"
                                  onAction="#logout"/>
                    </items>

                </MenuButton>

            </HBox>

            <!-- Navigation -->
            <HBox spacing="10">

                <Button text="Đăng sản phẩm"
                        onAction="#productPublishingSwitch"/>

                <Button text="Tất cả đấu giá"/>

                <Button text="Phiên tôi tham gia"
                        onAction="#myAuctionSwitch"/>

                <Button text="Nạp tiền"
                        onAction="#walletSwitch"/>

            </HBox>

            <!-- Search -->
            <HBox spacing="10">

                <TextField fx:id="searchField"
                           promptText="Tìm kiếm sản phẩm..."
                           HBox.hgrow="ALWAYS"/>

                <ComboBox fx:id="categoryFilter"
                          promptText="Danh mục"/>

                <ComboBox fx:id="statusFilter"
                          promptText="Trạng thái"/>

                <Button text="Tìm"
                        onAction="#searchAuction"/>

            </HBox>

        </VBox>
    </top>

    <!-- AUCTION LIST -->
    <center>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">

            <content>

                <FlowPane fx:id="auctionContainer"
                          hgap="20"
                          vgap="20"
                          prefWrapLength="1000">

                    <padding>
                        <Insets top="20"
                                right="20"
                                bottom="20"
                                left="20"/>
                    </padding>

                </FlowPane>

            </content>

        </ScrollPane>

    </center>

</BorderPane>
